/* pages/room/room.wxss */
.header {
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}
.badge.silver    { background: linear-gradient(135deg, #dbeafe, #93c5fd); color: #1e293b; }
.badge.prismatic { background: linear-gradient(135deg, #c084fc, #7c3aed); }
.badge.gold      { background: linear-gradient(135deg, #fcd34d, #f59e0b); color: #4c1d05; }

/* 玩家 2x2 网格（手机友好） */
.players {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.player {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 200rpx;
}
.player-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ec4899, #f43f5e);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.player-name {
  font-size: 28rpx;
  margin-top: 16rpx;
  text-align: center;
}

/* 卡牌 2 列网格 */
.cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

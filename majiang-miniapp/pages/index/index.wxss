/* pages/index/index.wxss */
.hero {
  padding-top: 60rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
}
.tab.active {
  background: linear-gradient(135deg, #ec4899, #f43f5e);
  color: #fff;
  font-weight: 600;
}
